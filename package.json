{
    "name": "ki-video",
    "version": "0.1.0",
    "private": true,
    "description": "Быстрый монтаж вертикальных роликов: веб-интерфейс на Bun + ffmpeg",
    "type": "module",
    "scripts": {
        "dev": "bun run --hot src/server/main.ts",
        "start": "bun run src/server/main.ts",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.app.json",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint .",
        "test": "bun test",
        "check": "bun run typecheck && bun test",
        "build": "bun run scripts/build.ts",
        "hooks": "git config core.hooksPath .githooks"
    },
    "dependencies": {
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@artemiy/oxfmt-allman": "0.62.0",
        "@types/bun": "latest",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "oxlint": "^1.81.0",
        "typescript": "^5.9.0"
    }
}
