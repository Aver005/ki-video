{
    "name": "ki-video",
    "version": "0.2.0",
    "private": true,
    "description": "Быстрый монтаж вертикальных роликов: веб-интерфейс на Bun + ffmpeg",
    "type": "module",
    "scripts": {
        "dev": "bun run --hot src/server/main.ts",
        "start": "bun run src/server/main.ts",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.app.json",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint .",
        "test": "bun test",
        "check": "bun run typecheck && bun test",
        "build": "bun run scripts/build.ts",
        "hooks": "git config core.hooksPath .githooks"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "cn": "^0.2.6",
        "lucide-react": "^1.42.0",
        "react": "^19.1.0",
        "react-aria-components": "^1.21.1",
        "react-dom": "^19.1.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@artemiy/oxfmt-allman": "0.62.0",
        "@types/bun": "latest",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "bun-plugin-tailwind": "^0.1.2",
        "oxlint": "^1.81.0",
        "shadcn": "^4.21.0",
        "tailwindcss": "4.1.14",
        "typescript": "^5.9.0"
    }
}
